{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pocket systems manifest",
  "type": "object",
  "required": ["systems"],
  "properties": {
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "platformId", "supportedExtensions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "displayName": { "type": "string" },
          "manufacturer": { "type": "string" },
          "platformId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Folder under Assets/. Defined by the openFPGA core, not standardised by Analogue." },
          "supportedExtensions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },
            "description": "File extensions matched by ROM copy. May be empty only when romFormat is 'folder'."
          },
          "romFormat": { "type": "string", "enum": ["file", "folder"],
            "description": "'file' (default): ROMs are individual files matched by extension. 'folder': each game is a directory copied whole (e.g. Neo Geo DarkSoft sets)." },
          "requiresCore": { "type": "boolean" },
          "suggestedCore": { "type": "string" },
          "biosRequired": { "type": "boolean" },
          "biosFiles": { "type": "array", "items": { "type": "string" } },
          "experimental": { "type": "boolean", "description": "Advanced/incomplete support (e.g. needs BIOS/romsets); the UI warns before use." },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
