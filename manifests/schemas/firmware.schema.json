{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pocket firmware manifest",
  "type": "object",
  "required": ["latest", "releases"],
  "properties": {
    "latest": { "type": "string", "description": "version string that must exist in releases[]" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "releaseDate", "url", "fileName", "md5", "sizeBytes"],
        "properties": {
          "version": { "type": "string" },
          "releaseDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "url": { "type": "string", "pattern": "^https://(www\\.)?analogue\\.co/" },
          "fileName": { "type": "string", "pattern": "\\.bin$" },
          "md5": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
