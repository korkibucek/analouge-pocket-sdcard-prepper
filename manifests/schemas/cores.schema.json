{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pocket cores manifest",
  "type": "object",
  "required": ["cores"],
  "properties": {
    "cores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "identifier", "displayName", "platformIds", "owner", "repo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "identifier": { "type": "string", "description": "Author.CoreName; also the folder under Cores/." },
          "displayName": { "type": "string" },
          "platformIds": { "type": "array", "minItems": 0, "items": { "type": "string" }, "description": "ROM platform ids (Assets/<id>/common). May be empty for cores with no ROM platform." },
          "owner": { "type": "string", "description": "GitHub owner used to resolve the release zip." },
          "repo": { "type": "string", "description": "GitHub repository name." },
          "tag": { "type": "string", "description": "Optional: pin a specific release tag instead of latest." },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$", "description": "Optional: expected SHA-256 of the release zip (pin a tag too)." },
          "homepage": { "type": "string" },
          "biosRequired": { "type": "boolean" },
          "biosFiles": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
